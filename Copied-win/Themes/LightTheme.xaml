<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 卡片背景 -->
    <SolidColorBrush x:Key="CardBackground" Color="#F7F7FA"/>

    <!-- 预览文字 -->
    <SolidColorBrush x:Key="PreviewTextBrush" Color="#3E3E3E"/>

    <!-- 元信息文字 -->
    <SolidColorBrush x:Key="MetaTextBrush" Color="#949496"/>

    <!-- 矢量图标填充 -->
    <SolidColorBrush x:Key="IconFillBrush" Color="#555555"/>

    <!-- 外层阴影（环境光） -->
    <Color x:Key="OuterShadowColor">#000000</Color>
    <sys:Double x:Key="OuterShadowOpacity">0.12</sys:Double>

    <!-- 内层阴影（模拟边框） -->
    <Color x:Key="InnerShadowColor">#000000</Color>
    <sys:Double x:Key="InnerShadowOpacity">0.18</sys:Double>

</ResourceDictionary>
