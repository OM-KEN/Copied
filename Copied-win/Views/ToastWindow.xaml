<Window x:Class="Copied.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False"
        MaxWidth="360"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="RootGrid" Margin="32,32" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.0" ScaleY="0.0"/>
        </Grid.RenderTransform>
        <Grid.Effect>
            <BlurEffect x:Name="RootBlur" Radius="0"/>
        </Grid.Effect>

        <!-- 外层阴影（环境光） -->
        <Border x:Name="ShadowBorder" Background="Transparent" CornerRadius="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270"
                                  Opacity="{DynamicResource OuterShadowOpacity}" Color="{DynamicResource OuterShadowColor}"/>
            </Border.Effect>
        </Border>

        <!-- 卡片：阴影模拟描边 + 内阴影层次 -->
        <Border x:Name="CardBorder" CornerRadius="32">
            <Border.Background>
                <DynamicResource ResourceKey="CardBackground"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Direction="270"
                                  Opacity="{DynamicResource InnerShadowOpacity}" Color="{DynamicResource InnerShadowColor}"/>
            </Border.Effect>

            <Grid x:Name="ContentGrid" Margin="16" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.0" ScaleY="0.0"/>
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Viewbox x:Name="IconViewbox"
                         Width="32" Height="32"
                         VerticalAlignment="Top"
                         Margin="0,1,12,0">
                    <Canvas x:Name="IconCanvas" Width="24" Height="24"/>
                </Viewbox>

                <!-- Thumbnail -->
                <Grid x:Name="ThumbnailGrid"
                      Width="64" Height="64"
                      VerticalAlignment="Top"
                      Margin="0,1,12,0"
                      Visibility="Collapsed">
                    <Border x:Name="ThumbBorder">
                        <Image x:Name="ThumbnailImage"
                               Stretch="UniformToFill"
                               Width="64" Height="64"/>
                    </Border>
                </Grid>

                <!-- Right content -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock x:Name="PreviewText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PreviewTextBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="280"
                               MaxHeight="40"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="20"
                               RenderOptions.ClearTypeHint="Enabled"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>

                    <StackPanel x:Name="MetaPanel" Margin="0,8,0,0">
                        <StackPanel x:Name="SourcePanel"
                                    Orientation="Horizontal"
                                    MaxWidth="280"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="SourceLabel"
                                       Text="复制自 "
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MetaTextBrush}"
                                       LineHeight="16"
                                       RenderOptions.ClearTypeHint="Enabled"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                            <Image x:Name="SourceIconImage"
                                   Width="16" Height="16"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="SourceNameText"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MetaTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="248"
                                       LineHeight="16"
                                       Margin="4,0,0,0"
                                       RenderOptions.ClearTypeHint="Enabled"
                                       TextOptions.TextFormattingMode="Display"
                                       TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                        <TextBlock x:Name="DetailText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MetaTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"
                                   LineHeight="16"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed"
                                   RenderOptions.ClearTypeHint="Enabled"
                                   TextOptions.TextFormattingMode="Display"
                                   TextOptions.TextRenderingMode="ClearType"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
