          "stringUnit": {
            "state": "translated",
            "value": "外掛程式是包含 manifest.json 和 rules.json 的 .copiedplugin 檔案夾。僅支援宣告式規則（JSON 與規則運算式），不會執行程式碼。"
          }
        }
