    "按住左键时点击右键 → 自动 ⌘C 复制": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the left mouse button, then right-click to copy with ⌘C."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住左键时点击右键 → 自动 ⌘C 复制"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住滑鼠左鍵再按一下右鍵 → 自動以 ⌘C 複製"
          }
        }
      }
    },
    "功能": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature"
