    "弹窗显示期间，轻点修饰键快速触发右侧的按钮。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the pop-up is visible, tap the modifier key to trigger the button on the right."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹窗显示期间，轻点修饰键快速触发右侧的按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出視窗顯示時，輕按修飾鍵即可觸發右側按鈕。"
          }
        }
      }
    },
