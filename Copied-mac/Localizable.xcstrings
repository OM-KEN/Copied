    "退出": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束"
          }
        }
      }
    },
    "开启后，复制时仅在鼠标旁短暂出现图标，不弹出完整窗口。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, copying briefly shows an icon near the pointer instead of the full pop-up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，复制时仅在鼠标旁短暂出现图标，不弹出完整窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，複製時只會在指標旁短暫顯示圖示，不會彈出完整視窗。"
          }
        }
      }
    },
    "复制反馈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制反馈"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製回饋"
          }
        }
      }
    },
    "开机自启": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "zh-Hans": {
