{
  "version": "1",
  "rules": [
    {
      "id": "md-detect",
      "multiline": true,
      "pattern": "^(?=(?:.|\\n)*?(?:^#{1,6}\\s|\\*\\*|__|`[^`\\n]+`|\\[[^\\]]+\\]\\([^)]+\\)))[\\s\\S]+",
      "action": {
        "type": "transform",
        "title": "纯文本",
        "icon": "text.alignleft",
        "pattern": "\\*\\*(.+?)\\*\\*|__(.+?)__|\\*(.+?)\\*|_(.+?)_|`([^`\\n]+)`|\\[([^\\]]+)\\]\\([^)]+\\)|(^|\\n)[ \\t]*#{1,6}[ \\t]+|(^|\\n)[-*+]\\s+|(^|\\n)>\\s?",
        "replacement": "$1$2$3$4$5$6$7$8$9"
      }
    }
  ]
}
