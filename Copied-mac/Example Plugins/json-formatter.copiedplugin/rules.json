{
  "version": "1",
  "rules": [
    {
      "id": "json-detect",
      "pattern": "^\\s*[\\{\\[]",
      "extractValue": "0",
      "action": {
        "type": "openURL",
        "title": "格式化",
        "icon": "text.alignleft",
        "template": "https://jsonformatter.org/?json={value}"
      }
    }
  ]
}
