{
  "version": "1",
  "rules": [
    {
      "id": "base64-detect",
      "pattern": "^[A-Za-z0-9+/]{20,}={0,2}$",
      "extractValue": "0",
      "action": {
        "type": "transform",
        "title": "解码",
        "icon": "lock.open",
        "pattern": "^(.*)$",
        "replacement": "(Base64 内容 — 解码功能需要 macOS 内置 base64 命令)"
      }
    }
  ]
}
